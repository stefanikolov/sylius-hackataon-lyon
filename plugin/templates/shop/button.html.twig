{# "Add to Wishlist" button. Rendered through Twig hooks on the product page and on every product card. #}
{% set product = hookable_metadata.context.product %}
{% set variant = product.enabledVariants.first %}

{% if variant %}
    <form action="{{ path('hackathon_wishlist_add', {variantId: variant.id}) }}" method="post" class="my-2" {{ sylius_test_html_attribute('wishlist-form') }}>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('hackathon_wishlist') }}">
        <button type="submit" class="btn btn-sm btn-outline-secondary" {{ sylius_test_html_attribute('add-to-wishlist') }}>
            {% if hackathon_wishlist_has(variant) %}
                &#9829; {{ 'hackathon_wishlist.ui.in_wishlist'|trans }}
            {% else %}
                &#9825; {{ 'hackathon_wishlist.ui.add'|trans }}
            {% endif %}
        </button>
    </form>
    {# Product page only: send the options picked in the add-to-cart form, so the chosen variant is saved. #}
    <script>
        (function () {
            var form = document.currentScript.previousElementSibling;
            form.addEventListener('submit', function () {
                var cart = document.querySelector('form[name="sylius_shop_add_to_cart"]');
                if (!cart) { return; }
                form.querySelectorAll('input[data-wishlist-option]').forEach(function (input) { input.remove(); });
                cart.querySelectorAll('select[data-option]').forEach(function (select) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'options[' + select.dataset.option + ']';
                    input.value = select.value;
                    input.setAttribute('data-wishlist-option', '');
                    form.appendChild(input);
                });
            });
        })();
    </script>
{% endif %}
