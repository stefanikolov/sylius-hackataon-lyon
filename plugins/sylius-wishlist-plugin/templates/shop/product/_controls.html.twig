{# Parameters: product, form_id, with_lists (bool), size ('sm' or ''), dropdown (bool, optional). #}
{# The controls point to the wishlist form with the form attribute, so they can sit anywhere on the page, also inside another form. #}
{# With several lists the visitor chooses the destination: a select next to the button, or (dropdown) a menu where one click chooses and adds. #}
{% set lists = with_lists ? mark_app_wishlist_lists() : [] %}
{% set button_class = 'btn btn-outline-primary' ~ (size == 'sm' ? ' btn-sm' : '') %}

{% if dropdown|default(false) and lists|length > 1 %}
    <div class="dropdown" {{ sylius_test_html_attribute('add-to-wishlist-dropdown') }}>
        <button type="button" class="{{ button_class }} dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">&hearts; {{ 'mark_app_sylius_wishlist.ui.add_to_wishlist'|trans }}</button>
        <ul class="dropdown-menu">
            <li><h6 class="dropdown-header">{{ 'mark_app_sylius_wishlist.ui.choose_list'|trans }}</h6></li>
            {% for list in lists %}
                <li><button type="submit" form="{{ form_id }}" name="wishlist" value="{{ list.id }}" class="dropdown-item" {{ sylius_test_html_attribute('add-to-wishlist-list') }}>{{ list.name }}</button></li>
            {% endfor %}
        </ul>
    </div>
{% else %}
    {% if lists|length > 1 %}
        <select name="wishlist" form="{{ form_id }}" class="form-select {{ size == 'sm' ? 'form-select-sm' : '' }} w-auto" aria-label="{{ 'mark_app_sylius_wishlist.ui.choose_list'|trans }}">
            {% for list in lists %}
                <option value="{{ list.id }}">{{ list.name }}</option>
            {% endfor %}
        </select>
    {% endif %}

    <button type="submit" form="{{ form_id }}" class="{{ button_class }}" {{ sylius_test_html_attribute('add-to-wishlist-button') }}>&hearts; {{ 'mark_app_sylius_wishlist.ui.add_to_wishlist'|trans }}</button>
{% endif %}
