{% import '@SyliusShop/shared/buttons.html.twig' as buttons %}
{% set form = hookable_metadata.context.form %}
{% set product = hookable_metadata.context.product %}
{% set variant = form.cartItem.vars.value.variant %}
{% set enabled = form.vars.valid and variant is not null and variant.enabled %}

{#
    shortcut: this replaces the Sylius "submit" hookable so the wishlist button can share a row with "Add to cart".
    It repeats the few lines of the Sylius template; check it again after a Sylius upgrade.
#}
<div class="mb-3 d-flex flex-wrap align-items-center gap-2">
    {{ buttons.submit('sylius.ui.add_to_cart'|trans, 'add-to-cart-button', null, 'btn-primary', not enabled) }}
    {% include '@MarkAppSyliusWishlistPlugin/shop/product/_controls.html.twig' with { product: product, form_id: 'wl-add-main-' ~ product.id, with_lists: true, size: '' } only %}
</div>
