<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping
        xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                            http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <mapped-superclass name="MarkApp\SyliusWishlistPlugin\Entity\WishlistItem" table="mark_app_wishlist_item">
        <unique-constraints>
            <unique-constraint name="uniq_mark_app_wishlist_item_variant" columns="wishlist_id,variant_id" />
        </unique-constraints>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <many-to-one field="wishlist" target-entity="MarkApp\SyliusWishlistPlugin\Entity\WishlistInterface" inversed-by="items">
            <join-column name="wishlist_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="product" target-entity="Sylius\Component\Core\Model\ProductInterface">
            <join-column name="product_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="variant" target-entity="Sylius\Component\Core\Model\ProductVariantInterface">
            <join-column name="variant_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
