<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="MarkApp\SyliusWishlistPlugin\Grid\Filter\CustomerSearchFilter">
            <tag name="sylius.grid_filter" type="mark_app_wishlist_customer" form_type="Sylius\Bundle\GridBundle\Form\Type\Filter\StringFilterType" />
        </service>

        <service id="MarkApp\SyliusWishlistPlugin\Menu\AdminMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" method="__invoke" />
        </service>
    </services>
</container>
